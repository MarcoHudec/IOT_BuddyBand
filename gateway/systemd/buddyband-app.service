# BuddyBand teacher app – local copy served by the Pi (architecture.md §5.4)
# http://raspberrypi47.local:8080  (works without internet, talks MQTT over WebSocket to RabbitMQ)
# Files: ~/buddyband-app (copy of app/ from the repo), config.json written by install_services.sh
[Unit]
Description=BuddyBand teacher app (local copy, port 8080)
After=network-online.target rabbitmq-server.service
Wants=network-online.target

[Service]
User=@OWNER@
ExecStart=/usr/bin/python3 -m http.server 8080 --directory @HOME@/buddyband-app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

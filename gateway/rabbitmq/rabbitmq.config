%% RabbitMQ configuration for the BuddyBand gateway.
%% Based on rabbitmq-configuration/rabbitmq.config from the course repo:
%% MQTT plugin on port 1883, messages routed to the amq.topic exchange.
[
  {rabbitmq_mqtt, [{default_user,     <<"admin">>},
                   {default_pass,     <<"admin">>},
                   {allow_anonymous,  false},
                   {vhost,            <<"/">>},
                   {exchange,         <<"amq.topic">>},
                   {tcp_listeners,    [{"0.0.0.0", 1883}]}]}
].

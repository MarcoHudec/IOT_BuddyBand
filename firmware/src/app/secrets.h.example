// Teacher band uplink credentials (WP3).
// Copy to secrets.h (same folder) and fill in. secrets.h is in .gitignore – never commit it.
// MQTT_USER / MQTT_PASS: from ~/.config/buddyband/credentials.env (BB_TEACHER_PW),
// generated by gateway/setup_pi.sh. `tools/make_secrets.sh` fills them in for you.
#pragma once

// Wi-Fi: 2.4 GHz, WPA2-Personal (phone hotspot: enable "maximize compatibility" / 2.4 GHz band)
#define WIFI_SSID   "CHANGE_ME"
#define WIFI_PASS   "CHANGE_ME"

// MQTT broker = Raspberry Pi gateway. ".local" names are resolved via mDNS.
#define MQTT_HOST   "raspberrypi47.local"
#define MQTT_PORT   1883
#define MQTT_USER   "teacher-band"
#define MQTT_PASS   "CHANGE_ME"

// Optional fallback if mDNS does not work on the hotspot (fill in the Pi's IP):
// #define MQTT_HOST_IP "192.168.43.10"
